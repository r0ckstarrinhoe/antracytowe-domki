rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Deny ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    // --- Houses ---
    match /houses/{houseId} {
      allow read: if true;
      allow write: if true; // Simplified for now as requested or implied
    }

    // --- Reservations ---
    match /reservations/{reservationId} {
      allow read, write: if true;
    }

    // --- Blocked Dates ---
    match /blocked_dates/{dateId} {
      allow read, write: if true;
    }

    // --- Special Prices ---
    match /special_prices/{priceId} {
      allow read, write: if true;
    }

    // --- House Settings ---
    match /house_settings/{houseId} {
      allow read, write: if true;
    }

    // --- Global Settings ---
    match /global_settings/{settingId} {
      allow read, write: if true;
    }

    // --- Admins ---
    match /admins/{uid} {
      allow read, write: if true;
    }
  }
}

